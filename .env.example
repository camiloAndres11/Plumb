# Copia este archivo a .env (que esta en .gitignore) y pon los valores reales.

# Fuente de datos de filtro, radar y simulador: croma | (vacio = fixtures commiteados)
PLIEGO_FUENTE=
# Llave de organizacion de Croma (platform.usecroma.com > API keys), croma_live_...
CROMA_API_KEY=
# Primer anio del historico a traer de Croma; por defecto hace 4 anios
CROMA_DESDE_ANIO=
# Vigencia en horas de la cache de Croma en data/cache/croma/ (0 la desactiva); por defecto 24
CROMA_CACHE_HORAS=

# ---- Plataforma (plataforma/, puerto 8100) ----
# Postgres con el esquema `pliego` (python -m plataforma.migrar). Con docker compose: postgresql://plomada:plomada@127.0.0.1:5432/plomada
DATABASE_URL=
# Firma de cookies y tokens, >= 32 bytes: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
# URL publica del servicio; va en los enlaces de los correos
BASE_URL=http://127.0.0.1:8100
# smtp://usuario:clave@host:587?tls=1 ; vacio = los correos se imprimen en el log
SMTP_URL=
CORREO_REMITENTE=Pliego <no-responder@pliego.co>
# Emails separados por coma que ven /admin
PLATAFORMA_ADMINS=
# Raiz de datos en disco (warehouse DuckDB, cache de Croma, PDFs); en Render, el disco persistente
PLATAFORMA_DATOS=data
# Llave de Anthropic de la plataforma para extraer pliegos con Claude (fase 5); vacia = los pliegos quedan en 'subido'
ANTHROPIC_API_KEY=
