# Copia este archivo a .env (que esta en .gitignore) y pon los valores reales.

# Fuente de datos de filtro, radar y simulador: croma | (vacio = fixtures commiteados)
PLIEGO_FUENTE=
# Llave de organizacion de Croma (platform.usecroma.com > API keys), croma_live_...
CROMA_API_KEY=
# Primer anio del historico a traer de Croma; por defecto hace 4 anios
CROMA_DESDE_ANIO=
# Vigencia en horas de la cache de Croma en data/cache/croma/ (0 la desactiva); por defecto 24
CROMA_CACHE_HORAS=
